{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "commit",
    "dirty",
    "created_at",
    "environment",
    "scope",
    "artifacts",
    "checks",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "weaver-verification-run-1"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dirty": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "platform"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "scope": {
      "const": "local-checks-not-independent-reproduction"
    },
    "artifacts": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "returncode",
          "status",
          "log",
          "log_sha256"
        ],
        "properties": {
          "name": {
            "enum": [
              "tests",
              "witness",
              "mutations"
            ]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "returncode": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "log": {
            "type": "string"
          },
          "log_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            },
            "then": {
              "properties": {
                "returncode": {
                  "const": 0
                }
              }
            },
            "else": {
              "properties": {
                "returncode": {
                  "not": {
                    "const": 0
                  }
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "name": {
                "const": "tests"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "witness"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "mutations"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "status": {
                  "const": "FAIL"
                }
              }
            }
          }
        }
      }
    }
  ]
}

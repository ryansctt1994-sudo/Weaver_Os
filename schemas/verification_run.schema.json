{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weaver verification report v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "source_head_sha",
    "verified_commit_sha",
    "base_sha",
    "dirty",
    "created_at",
    "scope",
    "lockfile_sha256",
    "wheel_sha256",
    "environment",
    "github_run_id",
    "commands",
    "verifiers",
    "adversarial_results",
    "artifact_hashes",
    "evidence_manifest_sha256",
    "implementation_status",
    "overall_verdict"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "repository": {"type": "string", "minLength": 1},
    "source_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verified_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dirty": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "scope": {"const": "local-checks-not-independent-reproduction"},
    "lockfile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wheel_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "os", "platform", "runner"],
      "properties": {
        "python_version": {"type": "string"},
        "os": {"type": "string"},
        "platform": {"type": "string"},
        "runner": {"type": "string"}
      }
    },
    "github_run_id": {"type": ["string", "integer"]},
    "commands": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verifier", "step", "command", "exit_code", "status"],
        "properties": {
          "verifier": {"enum": [
            "unit_and_integration",
            "bound_witness",
            "mutation_suite",
            "adversarial_corpus",
            "installed_wheel",
            "formal_tlc",
            "static_analysis_strict"
          ]},
          "step": {"type": "string", "minLength": 1},
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "exit_code": {"type": "integer"},
          "status": {"enum": ["PASS", "FAIL"]}
        }
      }
    },
    "verifiers": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/verifier"},
      "allOf": [
        {"contains": {"properties": {"name": {"const": "unit_and_integration"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "bound_witness"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "mutation_suite"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "adversarial_corpus"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "installed_wheel"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "formal_tlc"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "static_analysis_strict"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "adversarial_results": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/adversarial"},
      "allOf": [
        {"contains": {"properties": {"case_id": {"const": "ADV-001"}}, "required": ["case_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"case_id": {"const": "ADV-002"}}, "required": ["case_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"case_id": {"const": "ADV-003"}}, "required": ["case_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"case_id": {"const": "ADV-004"}}, "required": ["case_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"case_id": {"const": "ADV-005"}}, "required": ["case_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"case_id": {"const": "ADV-006"}}, "required": ["case_id"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "artifact_hashes": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "evidence_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chronicle", "kernel", "receipt"],
      "properties": {
        "chronicle": {"const": "DEFERRED_TO_BOUND_WITNESS"},
        "kernel": {"const": "DEFERRED_TO_BOUND_WITNESS"},
        "receipt": {"const": "DEFERRED_TO_BOUND_WITNESS"}
      }
    },
    "overall_verdict": {"enum": ["PASS", "FAIL"]}
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "command", "exit_code", "status", "log", "log_sha256"],
      "properties": {
        "step": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exit_code": {"type": "integer"},
        "status": {"enum": ["PASS", "FAIL"]},
        "log": {"type": "string", "minLength": 1},
        "log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
          "then": {"properties": {"exit_code": {"const": 0}}},
          "else": {"properties": {"exit_code": {"not": {"const": 0}}}}
        }
      ]
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "exit_code", "steps"],
      "properties": {
        "name": {"enum": [
          "unit_and_integration",
          "bound_witness",
          "mutation_suite",
          "adversarial_corpus",
          "installed_wheel",
          "formal_tlc",
          "static_analysis_strict"
        ]},
        "status": {"enum": ["PASS", "FAIL"]},
        "exit_code": {"type": "integer"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
          "then": {
            "properties": {
              "exit_code": {"const": 0},
              "steps": {"items": {"allOf": [{"properties": {"status": {"const": "PASS"}}}]}}
            }
          },
          "else": {
            "properties": {
              "exit_code": {"not": {"const": 0}},
              "steps": {"contains": {"properties": {"status": {"const": "FAIL"}}, "required": ["status"]}}
            }
          }
        }
      ]
    },
    "adversarial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_name",
        "expected_verdict",
        "observed_verdict",
        "status",
        "failure_code",
        "fixture",
        "fixture_sha256",
        "exit_code"
      ],
      "properties": {
        "case_id": {"pattern": "^ADV-[0-9]{3}$"},
        "case_name": {"type": "string", "minLength": 1},
        "expected_verdict": {"const": "REJECT"},
        "observed_verdict": {"enum": ["REJECT", "UNEXPECTED_PASS"]},
        "status": {"enum": ["PASS", "FAIL"]},
        "failure_code": {"type": "string"},
        "fixture": {"type": "string", "minLength": 1},
        "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exit_code": {"type": "integer"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"overall_verdict": {"const": "PASS"}}, "required": ["overall_verdict"]},
      "then": {
        "properties": {
          "dirty": {"const": false},
          "wheel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "verifiers": {"items": {"properties": {"status": {"const": "PASS"}}}},
          "adversarial_results": {"items": {"properties": {"status": {"const": "PASS"}}}}
        }
      }
    }
  ]
}

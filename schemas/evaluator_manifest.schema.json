{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/weaver/evaluator_manifest.schema.json",
  "title": "Evaluator Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluator_id", "version", "level", "criteria", "mutation_invalidates", "metadata"],
  "properties": {
    "evaluator_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "level": {"type": "string", "enum": ["E0", "E1", "E2", "E2.5", "E3", "E3.5", "E4", "E5", "E6", "E7", "E8"]},
    "criteria": {"type": "array", "items": {"type": "string"}},
    "mutation_invalidates": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}

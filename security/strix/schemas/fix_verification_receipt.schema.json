{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weaver-os.local/schemas/fix_verification_receipt.schema.json",
  "title": "FixVerificationReceipt",
  "type": "object",
  "required": [
    "receipt_version",
    "receipt_type",
    "scanner",
    "target",
    "finding_id",
    "fix_commit",
    "verification_result",
    "authority_effect",
    "receipt_hash"
  ],
  "properties": {
    "receipt_version": { "const": "0.1" },
    "receipt_type": { "const": "FixVerificationReceipt" },
    "scanner": { "const": "strix" },
    "target": { "type": "string", "minLength": 1 },
    "finding_id": { "type": "string", "minLength": 1 },
    "fix_commit": { "type": "string", "minLength": 7 },
    "verification_result": { "enum": ["pass", "fail", "inconclusive"] },
    "authority_effect": { "enum": ["none", "reinstatement_candidate", "remain_challenged", "remain_suspended"] },
    "receipt_hash": { "type": "string" }
  },
  "additionalProperties": false
}
